{
  "name": "langalpha-desktop",
  "version": "0.1.3",
  "private": true,
  "description": "Desktop shell for LangAlpha",
  "homepage": "https://langalpha.ai",
  "author": {
    "name": "Ginlix AI",
    "email": "contact@ginlix.ai"
  },
  "main": "src/index.js",
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "postinstall": "node -e \"require('electron')\"",
    "start": "node scripts/write-build-config.mjs && electron .",
    "test": "node --test",
    "preview": "node scripts/preview.mjs",
    "icons": "node scripts/make-icons.mjs",
    "build": "node scripts/write-build-config.mjs && node scripts/make-icons.mjs && node scripts/build.mjs --dir",
    "dist": "node scripts/write-build-config.mjs && node scripts/make-icons.mjs && node scripts/build.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.33.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
