{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@/*": [
        "../../../../web/src/*"
      ]
    },
    "noImplicitAny": true,
    "noImplicitThis": true
  },
  "include": [
    "*.js",
    "comments-shared.generated.d.ts"
  ],
  // Its source is type-checked in web; the other parts are checked against
  // the declarations generated beside it.
  "exclude": [
    "comments-shared.generated.js"
  ]
}
