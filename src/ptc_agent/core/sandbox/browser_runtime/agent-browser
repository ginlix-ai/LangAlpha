#!/bin/sh
# agent-browser on a computer, first on every command's PATH. The browser runtime
# shipped beside the `la` CLI decides what runs (``browser_runtime/wrapper.py``),
# named by its whole path, which is how the runtime tells its own commands apart.
runtime=$(cd "$(dirname "$0")/../../browser_runtime" && pwd -P) || exit 127
exec python3 -I "$runtime" agent-browser "$@"
