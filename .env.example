# =============================================================================
# LangAlpha Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys.
#
# Quick start (Docker): set the two required keys below, then `docker compose up`
# Everything else has sensible defaults that work out of the box.
# =============================================================================

# =============================================================================
# Recommended — unlock the full experience (but not required to get started)
# =============================================================================
# LangAlpha works with zero external keys: Docker provides sandbox execution,
# Yahoo Finance MCP servers provide free data (enable in agent_config.yaml),
# and LLM access comes from your own subscription via OAuth.

# Daytona Sandbox — persistent cloud sandboxes with cross-session workspaces
# Get a key at https://www.daytona.io/
# When set, the sandbox provider auto-detects to "daytona".
# When empty, falls back to "docker" (local Docker containers).
# Prebuild the per-tier snapshots with `make daytona-snapshots`.
DAYTONA_API_KEY=

# Required only for HOST_MODE=platform with Daytona. Use a deployment-unique
# namespace so staging and production never reconcile the same organization Secret.
DAYTONA_SECRET_NAMESPACE=

# E2B Sandbox: cloud sandboxes that pause when idle and resume in about a second
# Get a key at https://e2b.dev/dashboard?tab=keys
# Used when DAYTONA_API_KEY is empty; prebuild the per-tier templates with `make e2b-templates`.
E2B_API_KEY=
# Required with a platform-secret catalog on E2B. Use a
# deployment-unique namespace so two deployments never reconcile the same E2B Secret.
E2B_SECRET_NAMESPACE=
# Self-hosted E2B only: set E2B_DOMAIN, or E2B_API_URL together with E2B_SANDBOX_URL.
# E2B_DOMAIN=
# E2B_API_URL=
# E2B_SANDBOX_URL=

# Sandbox provider: auto-detected if not set. DAYTONA_API_KEY selects "daytona",
# else E2B_API_KEY selects "e2b", else "docker".
# Explicit values: "daytona" or "e2b" (hosted sandboxes), "docker" (local containers).
SANDBOX_PROVIDER=

# Docker socket exposed to the backend when SANDBOX_PROVIDER=docker.
# If your Docker context is rootless, set this to /run/user/<uid>/docker.sock.
DOCKER_HOST_SOCKET=/var/run/docker.sock

# Financial Modeling Prep — high-quality financial data for tools and MCP servers
# Free tier available at https://site.financialmodelingprep.com/
# Without this key, enable Yahoo Finance MCP servers in agent_config.yaml for free data.
# With HOST_MODE=platform on Daytona or E2B, sandboxes get it only through a platform-secret
# catalog entry, and without one it is withheld from them.
FMP_API_KEY=

# =============================================================================
# LLM API Keys — set one, or use BYOK via OAuth (Codex, Claude)
# =============================================================================
# The default model is configured in agent_config.yaml. Set the key for
# whichever provider you want to use, or leave all empty and connect your
# existing AI subscription (ChatGPT, Claude) via OAuth in the UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MINIMAX_API_KEY=
ZAI_API_KEY=

# =============================================================================
# Web Search — at least one recommended for search tools
# =============================================================================
SERPER_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
PARALLEL_API_KEY=

# Web fetch delegation + site crawl (optional; in-house fetch needs no key)
FIRECRAWL_API_KEY=

# =============================================================================
# Optional Services
# =============================================================================

# Alpha Vantage (alternative financial data MCP server, disabled by default)
ALPHA_VANTAGE_API_KEY=

# X (Twitter) API — read-only Bearer Token for the X MCP server.
# Primary path: users store X_BEARER_TOKEN once in the UI, under Plugins →
#   Secrets, and it applies to every one of their workspaces.
# This host-env var is a single-tenant OSS-only fallback. Setting it here is NOT enough
# on its own — you also need to uncomment the env passthrough in agent_config.yaml under
# the `x_api` MCP server. Leaving env: {} means vault is the only auth path.
# Get a token at https://console.x.com/ (App → Keys and tokens → Bearer Token).
X_BEARER_TOKEN=

# LangSmith Tracing (disabled by default — set LANGSMITH_TRACING=true to enable)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langalpha

# =============================================================================
# Cloud Storage — for chart image uploads (optional)
# =============================================================================
# Provider is configured in config.yaml (storage.provider)

# --- AWS S3 ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_REGION=us-east-1
# S3_PUBLIC_URL_BASE=https://d1234.cloudfront.net
# The public URL base is for the keys the app links to directly (avatars,
# attachments, captured chart images, widgets). Workspace files and thread
# transcripts (blobs/), memo uploads (memo/), skill archives (user-skills/),
# raw tool result bodies (provenance/) and workspace uploads being assembled
# (uploads/) live in the same bucket and are only
# ever read through the API or a short-lived presigned URL, so the CDN or
# bucket policy behind the public base must not serve those prefixes. Match
# them anywhere in the path (STORAGE_KEY_PREFIX nests them), and refuse an
# encoded slash (%2F), which a store may decode into the key.

# Bucket addressing: virtual (default) | path | auto.
# Most cloud S3-compatible services use virtual-hosted addressing; self-hosted /
# path-only backends (e.g. MinIO) must set this to "path". For a custom endpoint,
# give the BARE host with no bucket subdomain — embedding the bucket doubles the key.
# STORAGE_ADDRESSING_STYLE=virtual
# STORAGE_ENDPOINT_URL=https://{bare-host}
# Download links and upload parts are signed for the endpoint the browser will
# follow. Set this when browsers reach the store at a different host than the
# backend does, e.g. a MinIO the backend calls by its compose service name.
# STORAGE_BROWSER_ENDPOINT_URL=http://localhost:9000

# Namespace for every key this deployment stores, when several deployments
# share one bucket (staging beside dev, say). Stored keys are content-addressed,
# so without it each deployment's cleanup can delete objects another still
# uses. Unset keeps keys at the bucket's top level. Set it before the first
# write: changing it later hides every object stored under the old prefix
# until they are copied across.
# STORAGE_KEY_PREFIX=staging/

# How workspace file bytes move between a sandbox and the object store:
# auto (default) | direct | relay. "direct" has the sandbox upload and download
# blobs itself over short-lived presigned URLs bound to each file's sha256;
# "relay" streams every byte through the backend. "auto" picks direct for a
# Daytona sandbox on an S3-compatible store and relay otherwise. Can also be
# set as storage.blob_transfer in agent_config.yaml.
# STORAGE_BLOB_TRANSFER=auto

# Large workspace uploads, up to 2 GB: the browser sends the file to the store
# in parts on presigned URLs, and the sandbox pulls the assembled object into
# the workspace folder. Off by default, because the bucket has to accept those
# PUTs from the browser first: give it a CORS rule allowing PUT from the app's
# own origins (no extra request headers, and nothing to expose, since the
# server lists the parts itself). It also takes a computer whose blob transfer
# resolves to "direct" (a Docker sandbox needs STORAGE_BLOB_TRANSFER=direct)
# and an S3-compatible store; a machine brought over SSH never uses it. Keep a
# lifecycle rule that aborts incomplete multipart uploads and expires uploads/
# after a day or two, for anything the app's own cleanup misses. Off, or where
# a computer cannot take it, uploads go through the backend and stop at 256 MB.
# Can also be set as storage.browser_uploads in agent_config.yaml.
# STORAGE_BROWSER_UPLOADS=false

# --- Cloudflare R2 ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL_BASE=https://cdn.yourdomain.com

# --- Alibaba Cloud OSS ---
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET_NAME=
# OSS_REGION=oss-cn-hangzhou
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# =============================================================================
# Auth — leave SUPABASE_URL empty to disable (recommended for local dev)
# =============================================================================
# Deployment mode: "oss" (no auth, local dev) or "platform" (full auth)
# HOST_MODE=oss

# When auth is disabled, this user ID is used for all requests
AUTH_USER_ID=local-dev-user

# Encryption key for API keys stored at rest (auto-generated by `make config`)
# Generate manually: openssl rand -hex 32
# BYOK_ENCRYPTION_KEY=

# Public base URL of this server (used in agent-generated URLs like preview links)
# Set to your public-facing URL in production (e.g. https://app.example.com)
# SERVER_BASE_URL=http://localhost:8000

# Where the web app is served, for the /a/<code> links the agent hands to a
# person (running apps). Defaults to SERVER_BASE_URL, which is right
# when one origin serves both the app and /api/v1. docker-compose.yml sets it
# to http://localhost:${FRONTEND_PORT}; for a host-side run with `pnpm dev`,
# set it to http://localhost:5173.
# PUBLIC_APP_URL=

# --- Preview proxy (private E2B computers) ---
# With sandbox.e2b.public_traffic false in agent_config.yaml, a computer's ports
# answer only requests carrying its access token, which a browser cannot add,
# so this server serves its previews: each one at
# <port>-<capability>.<host of this URL>, valid for the preview link's lifetime.
# Where previews are served is deployment configuration. Point a wildcard DNS
# record (and certificate) for *.<host> at this server, keep the Host header,
# allow WebSocket upgrades, and serve nothing else and cache nothing there.
# It must be https and a registrable domain of its own: boot refuses one on
# the same site as SERVER_BASE_URL, PUBLIC_APP_URL or a CORS origin, since
# preview code could then reach the app's cookies. Listing that domain in the
# private section of the Public Suffix List also makes each preview host its
# own site, so one preview cannot set a cookie another receives. Boot refuses
# private E2B computers without it.
# Locally, *.localhost resolves to this machine: http://preview.localhost:8000
# PREVIEW_PROXY_BASE_URL=
# Origins allowed to frame a preview (CSP frame-ancestors), e.g. the app's
# origin. Unset sends no frame-ancestors, as previews served directly do.
# PREVIEW_PROXY_FRAME_ANCESTORS=

# --- SSH tunnel gateway (machines the server cannot dial) ---
# A machine behind a router or NAT connects out to the gateway with
# `ssh -N -R ...` and the server reaches it through that tunnel; the SSH login
# stays end to end with the machine's own sshd. The gateway
# (`python -m src.server.ssh_gateway`) is a single instance per deployment that
# shares this database and BYOK_ENCRYPTION_KEY; docker-compose.yml has it under
# the `ssh-gateway` profile. Tunnels are off unless SSH_GATEWAY_ADDRESS is set.
# host:port where the backend dials the gateway, e.g. ssh-gateway:2023 in compose.
# SSH_GATEWAY_ADDRESS=
# host:port where users' machines dial it, when different from the above.
# It must carry plain TCP, so not behind an HTTP-only proxy or CDN.
# SSH_GATEWAY_PUBLIC_ADDRESS=
# What the gateway binds when run natively (default 0.0.0.0:2022, which
# covers IPv6 as well). The compose service always binds 0.0.0.0:2022 inside
# its container and ignores this.
# SSH_GATEWAY_LISTEN=0.0.0.0:2022
# What the gateway binds for the backend's login alone, when run natively; set,
# the address above refuses that login, so bind this one where only the backend
# reaches it (e.g. 127.0.0.1:2023) and point SSH_GATEWAY_ADDRESS at it. Unset,
# the backend logs in on the address above. The compose service binds
# 0.0.0.0:2023 inside its container, unpublished.
# SSH_GATEWAY_DIAL_LISTEN=
# Compose only: the host port the gateway service is published on (default
# 2022), e.g. ssh.example.com:2022 for SSH_GATEWAY_PUBLIC_ADDRESS.
# SSH_GATEWAY_PORT=2022
# Compose only: the gateway's database pool (default 15). A gateway restart
# reconnects every machine at once, and each write past this waits its turn;
# one connection is held for as long as the gateway runs, for its lock.
# SSH_GATEWAY_DB_POOL_MAX=15
# Compose only: the most memory the gateway may take (default 1g). Anyone may
# connect on its public port, so this is what a flood of them can cost the host.
# SSH_GATEWAY_MEM_LIMIT=1g

# --- Egress relay (OAuth-connected MCP servers, "Connectors") ---
# Sandboxes execute OAuth connector tools through the backend's egress relay;
# no vendor token ever enters a sandbox. Unset EGRESS_RELAY_SECRET keeps the
# relay disabled (everything else works normally).
# Generate: openssl rand -hex 32   (use 32+ bytes)
# EGRESS_RELAY_SECRET=

# Where sandboxes reach this backend: the relay (the client appends
# /v1/egress/{grant_id}) and the file mount that serves sandbox code memory,
# profile, automations and workflows, plus memos and transcripts read-only
# (/api/v1/livefs/). The mount needs no secret; a sandbox that cannot reach
# this URL runs without it: its code is refused those paths, the file tools
# still reach them, and transcripts are not shown.
# Defaults to SERVER_BASE_URL, adapted per sandbox provider:
#  - Docker sandboxes (default OSS setup): no configuration needed — a
#    localhost default is rewritten to the Docker host gateway automatically.
#  - Daytona sandboxes run in Daytona's cloud and can only reach a publicly
#    routable URL: your backend's public domain, or a tunnel (e.g.
#    `cloudflared tunnel --url http://localhost:8000`) for local development.
#    A local-only value is warned about at server enable and in backend logs.
#  - SSH machines reach it the same way, and the one-line command that adds
#    one fetches its script from it. With a localhost value that command
#    works only on the machine running this backend (a Mac adding itself);
#    the dialog says so, and any other machine is set up by hand. A value
#    only containers resolve (host.docker.internal) gives way, for that
#    command, to the address the browser reached this backend at.
# Point it at the API origin itself, never at an SPA frontend.
# EGRESS_RELAY_BASE_URL=

# Shared secret authenticating internal service-to-service calls (the backend
# dispatching PTC/report-back workflows to its own /messages endpoint).
# Required when HOST_MODE=platform; in oss mode the self-dispatch is trusted
# without it. An unauthenticated background dispatch is rejected with 403,
# never run in the foreground.
# Generate manually: openssl rand -hex 32
# INTERNAL_SERVICE_TOKEN=

# API base of a channel gateway, including any path prefix its routes mount
# under. With INTERNAL_SERVICE_TOKEN set, the agent can message the user on
# the chat apps connected to their account (send_message,
# list_message_targets). Unset, it has neither tool.
# CHANNEL_GATEWAY_URL=

# --- Outside apps (OAuth access tokens) ---
# Off unless all three are set; for now only GET /api/v1/auth/principal accepts them.
# The OAuth issuer outside apps get tokens from (must equal the tokens' iss claim)
# OAUTH_RESOURCE_ISSUER=
# Where that issuer publishes its signing keys (JWKS; RS256 only)
# OAUTH_RESOURCE_JWKS_URL=
# Comma-separated audiences this server accepts (a token's aud must include one)
# OAUTH_RESOURCE_AUDIENCE=

# =============================================================================
# Plugin marketplace (the Discover tab on the Plugins page)
# =============================================================================
# The catalog Discover lists: a github.com / gitlab.com / codeberg.org /
# bitbucket.org repository whose marketplace.json indexes its plugins. A
# /tree/<branch> URL pins a branch. Unset, Discover is off; the rest of the
# Plugins page works the same either way.
# PLUGIN_MARKETPLACE_URL=https://github.com/{owner}/{repository}

# Read-only GitHub token (fine-grained, Contents: read on the catalog
# repository) so a team can point Discover at its own private catalog. It is
# sent only to GitHub's API, only when fetching that catalog's own repository
# (the listing, and installs and updates of its plugins), and never along a
# redirect or to any other repository.
# PLUGIN_MARKETPLACE_TOKEN=

# =============================================================================
# Config overlays
# =============================================================================
# Names a YAML overlay layered over agent_config.yaml and config.yaml:
# APP_ENV=production reads agent_config.production.yaml and config.production.yaml
# beside them. Keys an overlay sets win (nested maps merge, lists replace);
# a null leaves the base value, so an overlay cannot remove a key.
# Unset reads the committed files only.
# APP_ENV=dev

# =============================================================================
# Infrastructure — controls whether Docker Compose starts PostgreSQL and Redis
# =============================================================================
# Set to "infra" to start PostgreSQL and Redis in Docker (default).
# Remove or leave empty to use your own database and Redis instances.
COMPOSE_PROFILES=infra

# =============================================================================
# Database
# =============================================================================
# DB_HOST is auto-set by docker-compose.yml (defaults to "postgres" service name).
# For host development (make dev), uncomment and set to localhost:
# DB_HOST=localhost
DB_TYPE=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
# TLS mode for all Postgres connections, including the checkpoint DB below.
# Default "prefer" uses TLS when the server offers it and plaintext when it
# doesn't. Set to "require" to fail loudly rather than fall back to plaintext.
# DB_SSLMODE=prefer

# =============================================================================
# Redis
# =============================================================================
# REDIS_URL is auto-set by docker-compose.yml (defaults to "redis" service name).
# For host development (make dev), uncomment and set:
# REDIS_URL=redis://:redis@localhost:6379/0
REDIS_PASSWORD=redis
# Override config.yaml redis.max_connections (default 150). Range [1, 10000].
# REDIS_MAX_CONNECTIONS=300

# Postgres connection pool overrides. Ranges [1, 500].
# POSTGRES_CHECKPOINTER_POOL_MAX=25
# POSTGRES_CONVERSATION_POOL_MAX=50

# =============================================================================
# Checkpoint DB — defaults to the same Postgres above
# =============================================================================
# Uncomment to use a separate database for LangGraph checkpoints
# MEMORY_DB_HOST=localhost
# MEMORY_DB_PORT=5432
# MEMORY_DB_NAME=langalpha
# MEMORY_DB_USER=postgres
# MEMORY_DB_PASSWORD=postgres

# OpenTelemetry (optional)
