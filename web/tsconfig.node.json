{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.js",
    "vitest.config.ts",
    "playwright.config.js",
    "eslint.config.js",
    "scripts/*.ts",
    "scripts/vite-plugins/*.ts",
    "scripts/check-critical-path.mjs",
    "e2e/global-setup.js"
  ]
}
