.venv/
# A nested package (libs/*) can carry its own venv and bytecode from a host run.
**/.venv/
node_modules/
.git/
.worktrees/
.worktree/
.env
.env.production
**/__pycache__/
**/*.pyc
# A host build of chartkit's render page: the images build their own, and stale
# hashed assets from the host would ship into every sandbox beside it.
libs/chartkit/chartkit/render/
.ruff_cache/
web/node_modules/
web/.pnpm-store/
# The image builds the CLI itself.
cli/node_modules/
cli/dist/
*.log
.pytest_cache/
*.egg-info/
dist/
build/
.mypy_cache/
docs/
# Backend tests
tests/
libs/chartkit/tests/
mcp_servers/tests/

# Frontend tests
web/src/**/__tests__/
web/src/test/
web/e2e/
web/**/*.test.*
web/**/*.spec.*
web/vitest.config.ts
web/playwright.config.js

# Dev-only design harnesses, served by `pnpm dev` and never bundled. They use
# the test factories dropped above, so the image's `tsc -b` cannot resolve them.
web/src/**/__preview__/
web/*-preview.html
