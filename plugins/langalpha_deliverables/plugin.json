{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "langalpha-deliverables",
  "version": "1.0.0",
  "description": "What the agent hands you. Reports, decks, workbooks and interactive dashboards, plus the chart annotation and design conventions that keep them looking like one house produced them.",
  "author": {
    "name": "LangAlpha",
    "url": "https://langalpha.ai"
  },
  "homepage": "https://langalpha.ai",
  "repository": "https://github.com/ginlix/langalpha",
  "license": "Apache-2.0",
  "keywords": [
    "reporting",
    "documents",
    "charts",
    "dashboards",
    "pptx",
    "xlsx"
  ],
  "extensions": {
    "ai.langalpha": {
      "skills": {
        "chart-annotation": {
          "icon": "chart-spline"
        },
        "docx": {
          "icon": "file-text"
        },
        "html-report": {
          "icon": "file-code"
        },
        "inline-widget": {
          "icon": "app-window"
        },
        "interactive-dashboard": {
          "icon": "layout-dashboard"
        },
        "pdf": {
          "icon": "file-type"
        },
        "pptx": {
          "icon": "presentation"
        },
        "ui-design": {
          "icon": "palette"
        },
        "xlsx": {
          "icon": "file-spreadsheet"
        }
      }
    }
  }
}
