# Kept in step with deploy/Dockerfile.dev.
# The chart render page chartkit snapshots with: the web app's chart alone,
# built apart from the app (web/vite.chart-render.config.js) and shipped into
# every sandbox with chartkit. Without it a snapshot reports itself unavailable.
FROM node:24-alpine AS chart-render
WORKDIR /web
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
COPY web/patches/ patches/
RUN npm install -g "$(node -p 'require("./package.json").packageManager')"
RUN --mount=type=cache,id=langalpha-web-pnpm-store,target=/pnpm-store \
    pnpm install --frozen-lockfile --store-dir /pnpm-store
# The build's inputs and nothing else, so an edit elsewhere under web/ (e2e,
# docs, the app's own entry) leaves this layer cached. tsconfig*.json all come
# because tsconfig.json references the others for the resolver.
COPY web/chart-render.html web/vite.chart-render.config.js web/postcss.config.js web/tsconfig*.json ./
COPY web/scripts/react-plugins.ts scripts/react-plugins.ts
COPY web/src/ src/
RUN CHART_RENDER_OUT_DIR=/chart-render pnpm run build:chart-render

# 3.13 is a floor, not a preference: the Redis cache and stream-reader pools are
# BlockingConnectionPool, whose waiter queue is an asyncio.Condition. Before
# 3.13, a waiter cancelled at its own deadline consumed a notify without
# re-delivering it, so a caller could time out — and be reported as pool
# exhaustion — while a connection sat free. See pyproject requires-python.
# The `la` CLI's bundle, which each computer gets with the internal packages.
FROM node:24-slim AS cli
WORKDIR /cli
COPY cli/package.json cli/pnpm-lock.yaml cli/pnpm-workspace.yaml ./
# The pnpm the lockfile was written by, as deploy/Dockerfile.web installs it.
RUN npm install -g "$(node -p 'require("./package.json").packageManager')"
RUN pnpm install --frozen-lockfile
COPY cli/ ./
RUN pnpm build

FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1

# Install minimal system dependencies (patchright will install its own browser + deps).
# tini is required so `init: true` in compose reaps orphaned browser subprocesses;
# without it python (PID 1) leaks Chrome helpers on every cancelled scrapling fetch.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    fonts-liberation \
    curl \
    postgresql-client \
    tini \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copy dependency files first for layer caching
COPY pyproject.toml uv.lock README.md ./
COPY libs/market-protocol/ libs/market-protocol/
COPY libs/chartkit/ libs/chartkit/

# Install dependencies (frozen = use lockfile exactly).
ARG INSTALL_OBSERVABILITY=false
ARG INSTALL_CLAUDE_CODE=false
RUN extras=""; \
    if [ "$INSTALL_OBSERVABILITY" = "true" ]; then extras="$extras --extra observability"; fi; \
    if [ "$INSTALL_CLAUDE_CODE" = "true" ]; then extras="$extras --extra claude-code"; fi; \
    uv sync --frozen --no-dev $extras

# Install browsers for Scrapling crawling
# patchright: Chromium for DynamicFetcher (Tier 2)
# scrapling install: Camoufox for StealthyFetcher (Tier 3)
RUN uv run patchright install --with-deps chromium \
    && uv run scrapling install

# Copy application source
COPY src/ src/
COPY --from=chart-render /chart-render/ libs/chartkit/chartkit/render/
COPY server.py .
COPY scripts/ scripts/
RUN chmod +x scripts/docker_entrypoint.sh
COPY config*.yaml ./
COPY agent_config*.yaml ./
COPY mcp_servers/ mcp_servers/
COPY plugins/ plugins/
COPY workflows/ workflows/
COPY cli/sandbox/ cli/sandbox/
COPY --from=cli /cli/dist/la.mjs cli/dist/la.mjs

# The commit this image was built from, stamped on every LangSmith run so a
# regression can be pinned to a deploy. Last, so a new SHA rebuilds only this.
ARG LANGALPHA_BUILD_SHA=
ENV LANGALPHA_BUILD_SHA=${LANGALPHA_BUILD_SHA}

EXPOSE 8000

# tini reaps orphaned browser subprocesses. `-s` registers as child
# subreaper so tini works even when not PID 1 (e.g. under compose's
# `init: true`, which puts docker-init at PID 1 and our tini at PID 7).
# Without `-s`, tini warns it can't reap and no-ops.
ENTRYPOINT ["/usr/bin/tini", "-s", "--"]
CMD ["uv", "run", "python", "server.py", "--host", "0.0.0.0", "--port", "8000"]
